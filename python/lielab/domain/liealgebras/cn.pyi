from typing import overload, TYPE_CHECKING

if TYPE_CHECKING:
    import numpy.typing as npt
    import numpy as np

class cn:
    point: npt.NDArray[np.floating]
    
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, matrix: npt.NDArray[np.complexfloating]) -> None: ...
    @staticmethod
    def basis(index: int, shape: int) -> cn: ...
    @staticmethod
    def zero(shape: int) -> cn: ...
    @staticmethod
    def from_vector(vector: npt.NDArray[np.floating]) -> cn: ...
    @staticmethod
    def project(matrix: npt.NDArray[np.complexfloating]) -> cn: ...
    @overload
    def __init__(self, n: int) -> None: ...
    @staticmethod
    def from_complex_vector(vector: npt.NDArray[np.complexfloating]) -> cn: ...
    def to_string(self) -> str: ...
    def get_dimension(self) -> int: ...
    def get_size(self) -> int: ...
    def is_abelian(self) -> bool: ...
    def get_shape(self) -> int: ...
    def get_point(self) -> npt.NDArray[np.floating]: ...
    def serialize(self) -> npt.NDArray[np.floating]: ...
    def unserialize(self, serialized: npt.NDArray[np.floating]) -> None: ...
    def get_matrix(self) -> npt.NDArray[np.floating]: ...
    def get_vector(self) -> npt.NDArray[np.floating]: ...
    def set_vector(self, vector: npt.NDArray[np.floating]) -> None: ...
    @overload
    def __call__(self, index: int) -> float: ...
    @overload
    def __call__(self, index1: int, index2: int) -> complex: ...
    def to_complex_vector(self) -> npt.NDArray[np.complexfloating]: ...
    # def __getitem__(self, index: int) -> complex: ...

    
